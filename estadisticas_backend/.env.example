DATABASE_URL=postgresql://user:pass@host:6543/postgres
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
# Auth (Supabase): SUPABASE_URL (claves asimetricas) y/o SUPABASE_JWT_SECRET (HS256)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=
# Solo desarrollo local: AUTH_REQUIRED=false desactiva la validacion del token
AUTH_REQUIRED=true
SQL_ECHO=false
# Rol por defecto de usuarios sin app_metadata.role (admin|scorer|viewer). Cuando todos tengan rol, usa viewer.
DEFAULT_ROLE=admin
# Agenda de equipos (opcional): descanso minimo entre partidos y maximo por dia
MIN_REST_MINUTES=180
MAX_GAMES_PER_DAY=2
